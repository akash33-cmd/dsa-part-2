class Solution(object):
    def generate(self, numRows):
        n = numRows
        triangle = []
        for i in range(n):
            rows = [1] * (i+1)
            for j in range(1,i):
                rows[j] = triangle[i-1][j-1] + triangle[i-1][j]
            triangle.append(rows)
        return triangle 

