class Solution:
    def subarrayXor(self, arr, m):
        # code here
        count = 0
        n = len(arr)
        for i in range(0,n):
            for j in range(i,n):
                xor = 0
                for k in range(i,j+1):
                    xor = xor^arr[k]
                if xor == m:
                    count += 1
        return count
                        
