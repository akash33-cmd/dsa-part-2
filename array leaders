class Solution:
    def leaders(self, arr):
        # code here
        ans = []
        maxi = 0
        n = len(arr)
        for i in range(n-1,-1,-1):
            if arr[i] >= maxi:
                maxi = max(maxi,arr[i])
                ans.append(maxi)
        ans.reverse()
        return ans
            
