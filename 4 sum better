class Solution(object):
    def fourSum(self, nums, target):
        nums.sort()
        n = len(nums)
        b = set()
        for i in range(0,n):
            for j in range(i+1,n):
                hashi = set()
                for k in range(j+1,n):
                    sumi = nums[i]+nums[j]
                    sumi += nums[k]
                    fourth = target - sumi
                    if fourth in hashi:
                        b.add((nums[i],nums[j],nums[k],fourth))
                    hashi.add(nums[k])
        ans = [list(t) for t in b]
        return ans 
