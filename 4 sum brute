class Solution(object):
    def fourSum(self, nums, target):
        n = len(nums)
        b = set()
        for i in range(0,n):
            for j in range(i+1,n):
                for k in range(j+1,n):
                    for l in range(k+1,n):
                        sumi = nums[i]+nums[j]
                        sumi += nums[k]
                        sumi += nums[l]
                        if sumi == target:
                            temp = [nums[i],nums[j],nums[k],nums[l]]
                            temp.sort()
                            b.add(tuple(temp))
        ans = [list(t) for t in b ]
        return ans 
