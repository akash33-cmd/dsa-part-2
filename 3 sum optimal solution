class Solution(object):
    def threeSum(self, nums):
        n = len(nums)
        ans = []
        nums.sort()
        for i in range(0,n):
            if i > 0 and nums[i] == nums[i-1]:
                continue
            j = i + 1
            k = n-1
            while j < k:
                sumi = nums[i] + nums[j] + nums[k]
                if sumi < 0:
                    j += 1
                elif sumi > 0:
                    k -= 1
                else :
                    temp = [nums[i] , nums[j] ,nums[k] ]
                    ans.append(temp)
                    j += 1
                    k -= 1
                    while j < k and nums[j] == nums[j-1]:
                        j += 1
        return ans
