class Solution:
    def subarrayXor(self, arr, m):
        # code here
        count = 0
        n = len(arr)
        for i in range(0,n):
            xor = 0
            for j in range(i,n):
                xor = xor ^ arr[j]
                if xor == m:
                    count += 1
        return count
                        
