class Solution:
    def leaders(self, arr):
        # code here
        ans = []
        n = len(arr)
        for i in range(0,n):
            leader = True
            for j in range(i+1,n):
                if arr[j] > arr[i]:
                    leader = False
            if leader == True :
                ans.append(arr[i])
        return ans
